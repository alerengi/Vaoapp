# ==============================================================================
# Vao - Variables de Entorno de Ejemplo (.env.example)
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a '.env.local' en este mismo directorio.
# 2. Completa los valores reales obtenidos de Supabase y Google Cloud.
# 3. NUNCA subas '.env.local' a Git ni compartas tus claves privadas.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE (Configuración de Base de Datos y Autenticación)
# ------------------------------------------------------------------------------
# Se obtienen en: Panel de Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Clave de servicio secreta (Service Role). SOLO para servidor y scripts manuales.
# NUNCA uses prefijo NEXT_PUBLIC_ para esta clave ni la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta-aqui

# ------------------------------------------------------------------------------
# GOOGLE PLACES API (Datos de Restaurantes)
# ------------------------------------------------------------------------------
# Se obtiene en: Google Cloud Console -> APIs & Services -> Credentials
# Esta clave solo se utiliza desde el servidor / scripts.
GOOGLE_PLACES_API_KEY=tu-google-places-api-key-secreta-aqui

# ------------------------------------------------------------------------------
# CONFIGURACIÓN DE LA APLICACIÓN
# ------------------------------------------------------------------------------
# URL base de la app para redirecciones OAuth y callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000
